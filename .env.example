# POC-01 only. Server-side variable; never expose with the VITE_ prefix.
APPS_SCRIPT_WEB_APP_URL=

# POC-02 only. 64 hex chars; server-side only, never use the VITE_ prefix.
APPS_SCRIPT_HMAC_SECRET=

# POC-04 only. Disabled by default; route accepts requests only in Vercel Preview.
POC04_ENABLED=false
POC04_ALLOWED_ORIGIN=
POC04_APPS_SCRIPT_WEB_APP_URL=
POC04_APPS_SCRIPT_HMAC_SECRET=
